# Copy to .env (never commit .env) and fill in to enable the real LLM
# interpreter. All three are required together; without them the app runs
# fully offline with the deterministic interpreter.
#
# Any OpenAI-compatible chat-completions endpoint works, e.g.:
#   LLM_BASE_URL=https://api.openai.com/v1     (or http://localhost:11434/v1)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Strands agent (Bedrock). Optional: set only BEDROCK_AGENT=1 to route
# /api/shifts/:id/agent through Amazon Bedrock via @strands-agents/sdk.
# AWS credentials come from the normal AWS credential chain (AWS_PROFILE /
# AWS_REGION or any chain the AWS SDK supports) — never put keys in this file.
#
# Explicit provider selection (never inferred from the model id):
#   AGENT_MODEL_PROVIDER=bedrock          # Nova via BedrockModel Converse (default)
#   AGENT_MODEL_ID=ca.amazon.nova-lite-v1:0
# or:
#   AGENT_MODEL_PROVIDER=bedrock-openai   # Luna via OpenAI Responses API on bedrock-runtime
#   AGENT_MODEL_ID=global.openai.gpt-5.6-luna
# AGENT_MODEL_ID falls back to the legacy BEDROCK_MODEL_ID.
BEDROCK_AGENT=
# AWS_PROFILE=shift-handoff
# AWS_REGION=ca-central-1
# AGENT_MODEL_PROVIDER=bedrock
# AGENT_MODEL_ID=ca.amazon.nova-lite-v1:0

# Optional, has safe defaults:
# PORT=7787
# DATA_FILE=data/shifts.json
# EVIDENCE_DIR=data/evidence   # local photo-evidence bytes (demo scope, not production storage)

# Store selection for the AgentCore runtime entrypoint (the local app always uses
# the JSON file): memory (default, per-session/ephemeral) | json | dynamodb.
# SHIFT_STORE=memory
# SHIFT_TABLE_NAME=ShiftContinuityAgent-shift-events   # required when SHIFT_STORE=dynamodb
