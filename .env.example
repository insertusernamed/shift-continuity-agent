# Copy to .env (never commit .env) and fill in to enable the real LLM
# interpreter. All three are required together; without them the app runs
# fully offline with the deterministic interpreter.
#
# Any OpenAI-compatible chat-completions endpoint works, e.g.:
#   LLM_BASE_URL=https://api.openai.com/v1     (or http://localhost:11434/v1)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Strands agent (Bedrock). Optional: set only BEDROCK_AGENT=1 to route
# /api/shifts/:id/agent through Amazon Bedrock via @strands-agents/sdk.
# AWS credentials come from the normal AWS credential chain (AWS_PROFILE /
# AWS_REGION or any chain the AWS SDK supports) — never put keys in this file.
# Default model id: ca.amazon.nova-lite-v1:0 (override with BEDROCK_MODEL_ID).
BEDROCK_AGENT=
# AWS_PROFILE=shift-handoff
# AWS_REGION=ca-central-1
# BEDROCK_MODEL_ID=ca.amazon.nova-lite-v1:0

# Optional, has safe defaults:
# PORT=7787
# DATA_FILE=data/shifts.json
