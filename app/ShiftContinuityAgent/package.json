{
  "name": "ShiftContinuityAgent",
  "version": "0.1.0",
  "description": "AgentCore Runtime host for the existing ShiftContinuityAgent (Strands + Amazon Bedrock).",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx main.ts",
    "dev": "tsx watch main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1130.0",
    "@aws-sdk/lib-dynamodb": "^3.1130.0",
    "@aws/bedrock-token-generator": "^1.1.0",
    "@strands-agents/sdk": "^1.17.0",
    "bedrock-agentcore": "^0.3.0",
    "openai": "^6.49.0",
    "tsx": "^4.19.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "bedrock-agentcore": {
      "@strands-agents/sdk": "$@strands-agents/sdk"
    }
  }
}
